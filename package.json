{
  "name": "vitesse-nuxt-electron",
  "productName": "Vitesse Nuxt Electron",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "A Nuxt 4 and Electron starter with isolated web applications and Electron Forge",
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YunLeFun/vitesse-nuxt-electron"
  },
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "nuxt dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "update-electron-app": "3.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@unocss/nuxt": "^66.11.0",
    "@vueuse/nuxt": "^15.0.0",
    "electron": "44.7.0",
    "eslint": "^10.12.0",
    "nuxt": "4.5.2",
    "typescript": "6.0.3",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "desktop": {
    "appId": "fun.yunle.vitesse-nuxt-electron",
    "updateRepository": "YunLeFun/vitesse-nuxt-electron",
    "updatesEnabled": true
  }
}
